{
  "name": "logback4js",
  "version": "1.0.1",
  "description": "Logger for JavaScript inspired by Logback.",
  "keywords": [
    "log",
    "logger"
  ],
  "scripts": {
    "build": "node tools/build-modules.js",
    "build:core": "vite build --config src/core/vite.config.js",
    "build:angular": "vite build --config src/appenders/angular/vite.config.js",
    "build:discord": "vite build --config src/appenders/discord/vite.config.js",
    "build:google-analytics": "vite build --config src/appenders/google-analytics/vite.config.js",
    "build:line": "vite build --config src/appenders/line/vite.config.js",
    "build:microsoft": "vite build --config src/appenders/microsoft/vite.config.js",
    "build:slack": "vite build --config src/appenders/slack/vite.config.js",
    "build:twitter": "vite build --config src/appenders/twitter/vite.config.js",
    "updatevers": "node tools/update-versions.js",
    "pubmods": "node tools/publish-modules.js",
    "publish:core": "npm run build:core && npm publish ./dist/core",
    "publish:angular": "npm run build:angular && npm publish ./dist/appenders/angular",
    "publish:discord": "npm run build:discord && npm publish ./dist/appenders/discord",
    "publish:google-analytics": "npm run build:google-analytics && npm publish ./dist/appenders/google-analytics",
    "publish:line": "npm run build:line && npm publish ./dist/appenders/line",
    "publish:microsoft": "npm run build:microsoft && npm publish ./dist/appenders/microsoft",
    "publish:slack": "npm run build:slack && npm publish ./dist/appenders/slack",
    "publish:twitter": "npm run build:twitter && npm publish ./dist/appenders/twitter",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumo01GitHub/logback4js.git"
  },
  "author": "kumo01",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@logback4js/angular": "file:src/appenders/angular",
    "@logback4js/core": "file:src/core",
    "@logback4js/discord": "file:src/appenders/discord",
    "@logback4js/google-analytics": "file:src/appenders/google-analytics",
    "@logback4js/line": "file:src/appenders/line",
    "@logback4js/mail": "file:src/appenders/mail",
    "@logback4js/microsoft": "file:src/appenders/microsoft",
    "@logback4js/slack": "file:src/appenders/slack",
    "@logback4js/twitter": "file:src/appenders/twitter",
    "@npmcli/package-json": "^6.1.1",
    "@npmcli/run-script": "^9.1.0",
    "@types/jest": "^29.5.13",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "semver": "^7.7.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-static-copy": "^3.0.0"
  }
}
