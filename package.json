{
  "name": "logback4js",
  "version": "2.3.1",
  "description": "Logger for JavaScript inspired by Logback.",
  "keywords": [
    "log",
    "logger"
  ],
  "workspaces": [
    "src/core",
    "src/appenders/*"
  ],
  "scripts": {
    "build": "node tools/build-modules.js",
    "build:core": "vite build --config src/core/vite.config.js",
    "build:database": "vite build --config src/appenders/database/vite.config.js",
    "build:discord": "vite build --config src/appenders/discord/vite.config.js",
    "build:google-analytics": "vite build --config src/appenders/google-analytics/vite.config.js",
    "build:line": "vite build --config src/appenders/line/vite.config.js",
    "build:mail": "vite build --config src/appenders/mail/vite.config.js",
    "build:microsoft": "vite build --config src/appenders/microsoft/vite.config.js",
    "build:slack": "vite build --config src/appenders/slack/vite.config.js",
    "build:twitter": "vite build --config src/appenders/twitter/vite.config.js",
    "updatevers": "node tools/update-versions.js",
    "pubmods": "node tools/publish-modules.js",
    "publish:core": "npm run build:core && npm publish ./dist/core --access=public",
    "publish:database": "npm run build:database && npm publish ./dist/appenders/database --access=public",
    "publish:discord": "npm run build:discord && npm publish ./dist/appenders/discord --access=public",
    "publish:google-analytics": "npm run build:google-analytics && npm publish ./dist/appenders/google-analytics --access=public",
    "publish:line": "npm run build:line && npm publish ./dist/appenders/line --access=public",
    "publish:mail": "npm run build:mail && npm publish ./dist/appenders/mail --access=public",
    "publish:microsoft": "npm run build:microsoft && npm publish ./dist/appenders/microsoft --access=public",
    "publish:slack": "npm run build:slack && npm publish ./dist/appenders/slack --access=public",
    "publish:twitter": "npm run build:twitter && npm publish ./dist/appenders/twitter --access=public",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumo01GitHub/logback4js.git"
  },
  "author": "kumo01",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@npmcli/package-json": "^6.1.1",
    "@npmcli/run-script": "^9.1.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.25.1",
    "jest": "^30.0.4",
    "semver": "^7.7.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-static-copy": "^3.0.0"
  }
}
